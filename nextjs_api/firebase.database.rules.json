{
  "rules": {
    ".read": false,
    ".write": false,
    "sensor_data": {
      ".read": true,
      ".indexOn": ["timestamp", "serverTimestamp"],
      "$entryId": {
        ".write": true,
        ".validate": "newData.hasChildren(['timestamp', 'serverTimestamp'])",
        "timestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "serverTimestamp": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "receivedAt": {
          ".validate": "newData.isString()"
        },
        "source": {
          ".validate": "newData.isString()"
        },
        "distance_cm": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },
    "device_health": {
      ".read": true,
      "esp32_cam": {
        ".write": true,
        ".validate": "newData.hasChildren(['lastPingAt', 'updatedAt'])",
        "lastPingAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "lastPingIso": {
          ".validate": "!newData.exists() || newData.isString()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "pingIntervalMs": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
        },
        "timeoutMs": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
        },
        "source": {
          ".validate": "!newData.exists() || newData.isString()"
        }
      }
    }
  }
}
