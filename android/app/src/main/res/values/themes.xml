<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Wrist" parent="Theme.Material3.DayNight">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>

    <style name="Theme.Wrist" parent="Base.Theme.Wrist" />
    
    <!-- NoActionBar theme -->
    <style name="Theme.Wrist.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    
    <!-- AppBarOverlay -->
    <style name="Theme.Wrist.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    
    <!-- PopupOverlay -->
    <style name="Theme.Wrist.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>